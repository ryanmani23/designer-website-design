# Cloudflare Workers Static Assets — custom response headers.
# Long-lived immutable caching for fingerprint-stable static assets so repeat
# visits don't re-validate every image/script. (dist/* keeps the default
# must-revalidate: those filenames are stable but their contents change on each
# build, so they must not be cached immutably.)
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/media/*
  Cache-Control: public, max-age=31536000, immutable
